<style>
  @font-face { font-family: "Creepster"; src: url("{{ 'creepster.woff2' | asset_url }}") format("woff2"); font-display: swap; }
  #shopify-section-{{ section.id }} { display: none; }
  :root {
    --heading-font-family: "Creepster", "Fjalla One", cursive; --heading-font-weight: 400; --heading-font-style: normal;
    --accent: 255 122 26; --button-background-primary: 255 122 26; --button-text-primary: 26 10 0;
    --on-sale-text: 230 95 0; --on-sale-badge-background: 255 122 26; --on-sale-badge-text: 26 10 0;
    --primary-badge-background: 198 255 61; --primary-badge-text: 16 32 0;
  }
  :is(h1, h2, h3, h4, h5, .h0, .h1, .h2, .h3, .h4, .h5) { font-family: "Creepster", "Fjalla One", cursive !important; font-weight: 400 !important; letter-spacing: .04em; color: #ff7a1a; }
  .header__primary-nav :is(a, button, summary), .header__link-list :is(a, button, summary), .mega-menu :is(a, .h6, .bold), .navigation-drawer :is(a, button, summary) { font-family: "Creepster", "Fjalla One", cursive !important; font-weight: 400 !important; letter-spacing: .06em; }
  .header__primary-nav :is(a, button, summary):hover { color: #ff7a1a; }
  :is(.button, .btn, .shopify-payment-button__button--unbranded) { font-family: "Creepster", "Fjalla One", cursive !important; font-weight: 400 !important; letter-spacing: .08em; box-shadow: 0 0 18px rgb(255 122 26 / .35); }
  .product-card__title, .product-card__title a { font-family: "Creepster", "Fjalla One", cursive !important; font-weight: 400 !important; letter-spacing: .04em; color: #ff7a1a; }
  sale-price { color: #e65f00; font-weight: 700; }
  .prose a:not(.button), .breadcrumb a { color: #e65f00; }
  .footer :is(.h6, .h5, .bold, p.h6) { font-family: "Creepster", "Fjalla One", cursive !important; font-weight: 400 !important; letter-spacing: .05em; color: #ff7a1a; }
</style>
